{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "TZ"],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    ".prettierrc",
    ".npmrc",
    ".nvmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // Свой build, а не только ^build: тесты гоняются по dist (скрипт test во
    // всех пакетах — `find dist -name '*.test.js'`), поэтому пакет, который
    // тестируем, обязан быть собран. С одним ^build turbo собирал соседей и
    // пропускал сам пакет: прогон молча проверял ПРЕЖНЮЮ сборку и давал
    // зелёный на код, которого в dist нет. Свой build тянет ^build
    // транзитивно, так что каретка здесь лишняя.
    "test": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    }
  }
}
