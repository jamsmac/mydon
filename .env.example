# ─────────────────────────────────────────────────────────────
# MYDON — пример окружения. Реальные значения кладутся в .env
# (.env в .gitignore, НИКОГДА не коммитится). Ни одного ключа в коде.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=Asia/Tashkent

# ── MYDON Core: база данных (PostgreSQL) ──
# local = контейнер mydon-db; external = managed PostgreSQL. В external mode
# runtime URL обычно ведёт через session pooler, а ADMIN URL — прямо в БД и
# используется только для pg_dump/операционных чтений. Оба внешних URL обязаны
# требовать TLS; секреты остаются только в production .env.
DATABASE_MODE=local
DATABASE_URL=postgresql://mydon:password@localhost:5432/mydon
DATABASE_ADMIN_URL=
# 0 отключает контроль. Production Supabase Free предупреждает до лимита 500 МБ.
DATABASE_SIZE_WARN_MB=400
# Порт Core (по умолчанию 3001)
PORT=3001

# ── Синк снабжения (mydon-stock) ──
# База источника прихода/остатков (только чтение). Пусто → синк выключен.
STOCK_DATABASE_URL=

# ── Хранилище файлов (фото номенклатуры, чеки) ──
# Заданы endpoint+bucket+ключи → S3/MinIO; пусто → локальный диск STORAGE_LOCAL_DIR.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
# MinIO обычно требует path-style; отключить для «настоящего» S3 — false.
STORAGE_FORCE_PATH_STYLE=true
# Куда писать без S3 (том на Hetzner).
STORAGE_LOCAL_DIR=/data/attachments

# ── Telegram (основной канал) ──
TELEGRAM_BOT_TOKEN=
# белый список chat_id через запятую — все остальные отклоняются
TELEGRAM_ALLOWED_CHAT_IDS=

# ── LLM-провайдеры (мозг агентов) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Входящий шлюз реального времени (/api/ingest) ──
# Им же закрыт приём выгрузок: и скриптом (tools/import-raw.mjs), и файлом с
# экрана «Источники». Пусто → приём выключен, экран говорит об этом словами.
INGEST_KEY=

# ── Внутренний токен доступа к Core ──
# Мутации Core (панель, бот, агенты) требуют его в заголовке x-service-token.
# Пусто → ВСЕ мутации отклоняются 401 (fail-closed), Core предупреждает на
# старте. Задавайте ОДИН И ТОТ ЖЕ токен ОДНОВРЕМЕННО в Core и всем клиентам
# (панель/бот/агенты) — иначе они начнут получать 401 на запись.
SERVICE_TOKEN=

# Health становится degraded, если на файловом слое меньше этого остатка.
# Путь / внутри контейнера лежит на диске Docker-хоста; 0 отключает порог.
HEALTH_STORAGE_PATH=/
HEALTH_MIN_STORAGE_MB=1024

# Небезопасный аварийный вход сотрудников по освобождаемому @username.
# Штатный путь — одноразовое приглашение; включать только временно.
STAFF_LINK_BY_USERNAME=0

# ── Коннекторы ──
# VendHub / VHM24 (отдельный движок, подключается по API)
VHM24_API_URL=
VHM24_API_KEY=
# VendHub панель/офис (снятие отчётов источника). Пусто → коннектор выключен.
VH_PANEL_BASE=
VH_PANEL_TOKEN=
VH_PANEL_COOKIE=
VH_PANEL_LANG=ru
VH_OFFICE_BASE=
VH_OFFICE_SESSION=
VH_TIMEOUT=30000
# Платёжные системы — пока не подключены (см. отчёт Ф5)
MULTIKASSA_API_URL=
PAYME_API_KEY=
CLICK_API_KEY=
UZUM_API_KEY=
# Телефония
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# Didox (ЭДО РУз) — договоры и счета GLOBERENT полями API вместо выгрузки.
# Пусто → сбор выключен, работает прежний путь через сид.
# ВНИМАНИЕ: партнёрский токен НЕ выдаётся в личном кабинете. Его даёт
# аккаунт-менеджер Didox: t.me/Didox_account, +998 50 122 05 18.
DIDOX_BASE_URL=https://api-partners.didox.uz
DIDOX_PARTNER_TOKEN=
# ИНН компании и пароль пользователя Didox (вход без ЭЦП).
# Перебор пароля блокируется: 3 попытки в минуту → 10 минут, 10 → сутки.
DIDOX_TAX_ID=
DIDOX_PASSWORD=
# Необязательно: готовый токен пользователя, если вход сделан снаружи (живёт 6 часов).
DIDOX_USER_TOKEN=
# Ourvend (кабинет вендинга os.ourvend.com) — только чтение. Пусто → сбор выключен.
# Секреты СМЕНИТЬ перед запуском (Фаза 0 ТЗ) и держать только здесь, не в коде.
OURVEND_ACCOUNT=
OURVEND_PASSWORD=
OURVEND_GROUP_ID=729db8bd-02f5-49b9-bccb-53477e396a08
# Как часто собирать планограмму и продажи. "off" выключает сбор явно, пустая
# учётка выше — молча. Каждый сбор пишет slot_snapshot: это единственный
# материал для сверки заливки, поэтому реже 3 часов ставить не стоит. После
# слотов запускается детектор заливок.
OURVEND_SYNC_CRON=0 */3 * * *
# Сколько ждать ответа Core на ПРИЁМ вендинга (слоты, продажи, детектор
# заливок), мс. Обычные вызовы агентов по-прежнему ждут 10 секунд; приём — это
# одна транзакция на сотни строк, и на внешней базе по TLS он в 10 секунд не
# укладывался: с 24.08.2026 сбор падал каждые три часа «This operation was
# aborted» с machines_ok=0, хотя Core транзакцию дописывал. Пусто/мусор → 60000.
CORE_INGEST_TIMEOUT_MS=60000
# Учётный снапшот OurVend (П2 поглощения mydon-stock): суточные продажи по
# автоматам с догоном до 14 дней + утренний снимок остатков (Lot management).
# 08:05 — после съёма mydon-stock (07:50), чтобы паритет сверял одни сутки.
OURVEND_ACCOUNTING_CRON=5 8 * * *
# Источник учётного потока для Core: "stock" — чтение БД mydon-stock (как
# раньше), "own" — собственный снапшот. Переключать на own только после
# 7 зелёных дней GET /ourvend/parity (гейт П2 плана поглощения).
# П8b: это ФОЛБЭК под настройкой панели «Система» — переключатель теперь
# живёт в system_config (база важнее env), рунбук флипа — docs/CUTOVER.md.
# Без STOCK_DATABASE_URL значение здесь игнорируется — действует own.
OURVEND_ACCOUNTING_SOURCE=stock
# Маршрут загрузки автоматов для плана закупа (П5a): серийники через запятую;
# правится и из панели настроек (база важнее env).
VENDING_ROUTE_ORDER=
# Полевой снек-контур (П4): порог усушки автомата, сум (по позиции за
# период) и порог детектора заливки по снимкам слотов, шт за окно 3 ч.
# Оба правятся из панели настроек (база важнее env).
SHRINK_ALERT_UZS=30000
REFILL_DETECT_MIN_UNITS=10
# Аналитика снек-контура (П5b): окна и пороги отчётов. Правятся из панели
# «Система», и база важнее env — при пустом значении в базе читается env,
# при пустом и там действует дефолт (тот же приоритет, что у двух ключей
# выше). Значения ниже — дефолты кода; раскомментируйте только если хотите
# сдвинуть окно ДО первой правки из панели: выставленная здесь переменная
# действует на ВСЕ отчёты и в панели видна как источник «env».
# DEAD_STOCK_DAYS=21
# PRICE_CHANGE_PCT=5
# PRICE_GAP_PCT=5
# COST_WINDOW_DAYS=90
# MARGIN_LOW_PCT=15
# Оффсайт-бэкапы mydon в Telegram (П1 поглощения): свой бот и чат. Пусто →
# фолбэк на аварийного бота сторожа из /etc/mydon-heartbeat.env (шумно).
TG_BACKUP_BOT_TOKEN=
TG_BACKUP_CHAT_ID=
# Кого проверяет /opt/backups/healthz_guard.sh, в виде host:port. Пусто →
# адрес берётся из WEB_PORT в .env наблюдаемой панели склада (так работает
# сегодня). Заполните, чтобы сторож перестал заглядывать в каталог склада
# вовсе — это последняя оставшаяся у него зависимость (П8.2 поглощения).
# Пусто И там, и там — сторож не проверяет наугад, а падает с записью в
# /opt/backups/backup.log: молчаливая проверка чужого адреса = ложные тревоги.
HEALTHZ_TARGET=
# Мониторинг кофе-бункеров (недолив/расхождение расхода) — внешней учётки не требует.
# По умолчанию раз в сутки в 07:00 (Asia/Tashkent). "off" выключает.
COFFEE_MONITOR_CRON=0 7 * * *
# Монитор графиков обслуживания: ставит задачи на работы, подходящие к сроку.
# 06:00 — ДО дайджеста сотрудникам (07:00) и брифинга владельца (07:30):
# к моменту рассылки задачи уже должны стоять. "off" выключает.
MAINTENANCE_MONITOR_CRON=0 6 * * *
# Перец для хешей приглашений сотрудников. Случайная строка от 16 символов:
# в БД лежит только хеш кода, и без перца он подбирается по радужной таблице.
# Смена перца делает все ВЫДАННЫЕ приглашения недействительными.
INVITE_PEPPER=
# Аварийная привязка сотрудника по @username. Ник в Telegram освобождается
# после смены, и занявший его получит чужую карточку — поэтому штатный путь
# это одноразовое приглашение. "0" выключает привязку по нику совсем.
STAFF_LINK_BY_USERNAME=1
# Имя бота без @ — нужно панели, чтобы собрать ссылку-приглашение.
# Сам бот спрашивает его у Telegram при старте и это значение не читает.
TELEGRAM_BOT_USERNAME=
# История заливок кофе-бункеров: группа, указанная владельцем (t.me/c/3307473916,
# для Bot API — чат -1003307473916). Историю ДО подключения бота Bot API не отдаёт —
# импорт идёт через экспорт Telegram Desktop (JSON) + tools/import-telegram-coffee.mjs.
TELEGRAM_COFFEE_HISTORY_CHAT=-1003307473916
# Подсказка модели про формат сообщений в этой группе (если распознаётся мало).
TELEGRAM_COFFEE_HINT=
# Курс валют — открытый API, ключ не нужен
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/
# Автокурс ЦБ РУз (USD/CNY/EUR/RUB → fx_rate): раз в сутки в 09:05 (Asia/Tashkent).
# Ручной курс, заданный сегодня, автообновление не перекрывает. "off" выключает.
FX_REFRESH_CRON=5 9 * * *
# Монитор инвариантов конвейера GLOBERENT (ИМ-40 без ГТД, оплаченный договор
# без закрытия) — раз в сутки в 07:10 к утреннему брифингу. "off" выключает.
GLOBERENT_MONITOR_CRON=10 7 * * *
# Notion — куда агент публикует отчёт о находке (task-worker). Пусто → не публикует,
# отчёт всё равно остаётся в MYDON. Нужны оба: токен интеграции и id родительской страницы.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# ── Агенты ──
# Порог автономии: T0 = агенты только предлагают (ответ владельца Ф6)
AGENT_AUTONOMY_MAX=T0
AGENTS_SCHEDULES_PAUSED=1
# Дневной потолок действий на агента и период опроса задач (мс)
AGENT_DAILY_ACTION_CAP=50
AGENT_TASK_INTERVAL_MS=60000
# Денежный бюджет ($). subscription = метрируемых трат нет, потолок спит.
# metered = потолок активен (включать вместе с LLM_BASE_URL ниже).
AGENT_BILLING_MODE=subscription
AGENT_DAILY_BUDGET_USD=5
AGENT_GLOBAL_BUDGET_USD=5
# LLM-путь агентов. Три пути (все выключены по умолчанию):
#  • Подписка (Stage 0): LLM_PROVIDER=claude-cli | codex-cli | gemini-cli —
#    запускает соответствующий CLI-харнесс на подписке, трат по токенам нет.
#    Нужен установленный CLI (claude/codex/gemini) + его авторизация в окружении.
#    Эти харнессы claudexor ротирует по квотам поверх.
#  • HTTP (OpenAI-совместимый): задать LLM_BASE_URL — метрируемое API или
#    AI-gateway (напр. OmniRoute); держать ТОЛЬКО внутри Tailscale.
# Ничего не задано → LLM-путь выключен (детерминированные навыки как раньше).
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODELS=
# Точная команда харнесса зависит от версии CLI — при необходимости переопредели:
LLM_CLI_CMD=          # напр. claude | codex | gemini (иначе берётся из пресета)
LLM_CLI_BASE_ARGS=    # напр. "-p" (claude) | "exec" (codex)
LLM_CLI_PROMPT_VIA=   # stdin (по умолчанию) | arg
LLM_CLI_MODEL_FLAG=   # --model (claude) | -m (codex/gemini)
# Семантическая память (RAG, #6b): OpenAI-совместимый /embeddings. Пусто →
# память спит (остаётся дельта-память по сигнатуре). Держать в Tailscale.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=          # напр. text-embedding-3-small (иначе дефолт)
# Токен запуска Claude Code для агентов/документов. Пусто → исполнение выключено.
CLAUDE_CODE_OAUTH_TOKEN=
# Рабочая директория Cowork-исполнения
COWORK_BASE_DIR=

# ── Помощник (панель) ──
# Модель ассистента панели
MYDON_ASSISTANT_MODEL=

# ── История (локальная модель/индекс) ──
HISTORY_DB_PATH=
HISTORY_MODEL_DIR=

# ── Бот ──
CORE_API_URL=http://127.0.0.1:3001
NOTIFY_INTERVAL_MS=60000
# Периоды напоминаний (мс): просроченные задачи и переделки
REMIND_INTERVAL_MS=3600000
REDO_NOTIFY_INTERVAL_MS=3600000

# ── Внешний сторож (запускается на ДРУГОМ провайдере, отдельным ботом) ──
WATCHDOG_TARGET_URL=
WATCHDOG_BOT_TOKEN=
WATCHDOG_CHAT_IDS=
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_FAILURES=3

# ── Локальная rollback/recovery БД (docker compose) ──
POSTGRES_USER=mydon
POSTGRES_PASSWORD=
POSTGRES_DB=mydon

# Пароль шифрования offsite-копии секретов (.env-архив уходит в Telegram).
#
# Без него архив секретов НЕ отправляется наружу вовсе — открытым текстом
# класть пароль базы и токены ботов в чужое хранилище нельзя.
#
# ⚠️ Храните пароль ВНЕ сервера (менеджер паролей). Он есть и здесь, но
# offsite защищает от ПОТЕРИ машины: если пароль остался только на ней,
# восстановить зашифрованный архив будет нечем.
#
# Расшифровать: openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 \
#   -in env-files_ДАТА.tar.gz.enc -out env-files.tar.gz
BACKUP_ENC_PASSPHRASE=

# Второй независимый offsite: private Backblaze B2 bucket.
# Если все три значения пусты, канал ещё не активирован. Частичная конфигурация
# считается ошибкой backup. Все три архива шифруются и аутентифицируются через
# rclone crypt. Production key ограничьте одним bucket и префиксом: нужны
# listAllBucketNames, listBuckets, listFiles, readFiles, writeFiles и
# readBucketEncryption, но не deleteFiles. Отдельный read-only recovery key и
# BACKUP_ENC_PASSPHRASE храните вне production.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_PREFIX=mydon/daily
