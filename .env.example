# ─────────────────────────────────────────────────────────────
# MYDON — пример окружения. Реальные значения кладутся в .env
# (.env в .gitignore, НИКОГДА не коммитится). Ни одного ключа в коде.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=Asia/Tashkent

# ── MYDON Core: база данных (PostgreSQL) ──
# local = контейнер mydon-db; external = managed PostgreSQL. В external mode
# runtime URL обычно ведёт через session pooler, а ADMIN URL — прямо в БД и
# используется только для pg_dump/операционных чтений. Оба внешних URL обязаны
# требовать TLS; секреты остаются только в production .env.
DATABASE_MODE=local
DATABASE_URL=postgresql://mydon:password@localhost:5432/mydon
DATABASE_ADMIN_URL=
# 0 отключает контроль. Production Supabase Free предупреждает до лимита 500 МБ.
DATABASE_SIZE_WARN_MB=400
# Порт Core (по умолчанию 3001)
PORT=3001

# ── Синк снабжения (mydon-stock) ──
# База источника прихода/остатков (только чтение). Пусто → синк выключен.
STOCK_DATABASE_URL=

# ── Донор инкассаций VendCash (Railway) — ТОЛЬКО для разового скрипта ──
# Задаётся ОКРУЖЕНИЕМ на время одной команды (см. docs/DEPLOY.md, раздел
# «Разовые шаги среза «правда о пробеле»»). В боевом .env остаётся ПУСТО:
# донор — чужая база со своим владельцем и своим ботом, и постоянное
# подключение к ней Core не нужно ни для чего.
VENDCASH_DATABASE_URL=

# ── Хранилище файлов (фото номенклатуры, чеки) ──
# Заданы endpoint+bucket+ключи → S3/MinIO; пусто → локальный диск STORAGE_LOCAL_DIR.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
# MinIO обычно требует path-style; отключить для «настоящего» S3 — false.
STORAGE_FORCE_PATH_STYLE=true
# Куда писать без S3 (том на Hetzner).
STORAGE_LOCAL_DIR=/data/attachments

# ── Telegram (основной канал) ──
TELEGRAM_BOT_TOKEN=
# белый список chat_id через запятую — все остальные отклоняются
TELEGRAM_ALLOWED_CHAT_IDS=

# ── LLM-провайдеры (мозг агентов) ──
ANTHROPIC_API_KEY=
# GPT-5.6 Sol в Agents не читает общий OPENAI_API_KEY: его серверный ключ
# задаётся как LLM_API_KEY в едином LLM-профиле ниже.

# ── Входящий шлюз реального времени (/api/ingest) ──
# Им же закрыт приём выгрузок: и скриптом (tools/import-raw.mjs), и файлом с
# экрана «Источники». Пусто → приём выключен, экран говорит об этом словами.
INGEST_KEY=

# ── Внутренний токен доступа к Core ──
# Мутации Core (панель, бот, агенты) требуют его в заголовке x-service-token.
# Пусто → ВСЕ мутации отклоняются 401 (fail-closed), Core предупреждает на
# старте. Задавайте ОДИН И ТОТ ЖЕ токен ОДНОВРЕМЕННО в Core и всем клиентам
# (панель/бот/агенты) — иначе они начнут получать 401 на запись.
SERVICE_TOKEN=
# Отдельный длинный случайный секрет — «второй пояс» для owner-only операций
# (снятие LLM replay-блока и, после P5, approvals-решения, смена ролей,
# порог автономии). Держат его Core, CC (панель) И Bot — но каждый проставляет
# его ТОЛЬКО когда действие инициировал владелец: CC — из web-identity, Bot —
# адресно для owner-действий (кнопки согласования и напоминания владельца в
# Telegram); на путях сотрудников бот его НЕ шлёт (нет эскалации staff→owner).
# Agents его НЕ получают вовсе — этих путей они не проходят (R-P5-9). Задавайте
# ОДИН И ТОТ ЖЕ секрет в Core, CC и Bot; без него у бота при включённом
# ужесточении сломались бы owner-действия. Равенство SERVICE_TOKEN запрещено
# кодом fail-closed.
OWNER_ACTION_TOKEN=

# ── Web identity владельца (P5, R-P5-1/2/6) ──
# Панель (mydon-cc) должна стоять ЗА `tailscale serve`, а не bind прямо на
# Tailscale-IP: serve терминирует HTTPS, срезает клиентские Tailscale-*
# заголовки и проставляет доверенный Tailscale-User-Login. Тогда :3002 обязан
# слушать ТОЛЬКО loopback (PANEL_BIND=127.0.0.1), иначе заголовок подделываем
# прямым запросом в обход serve (R-P5-2). Механика — deploy/tailscale-serve-panel.sh,
# порядок выкатки — docs/DEPLOY.md.
#
# Интерфейс, на котором docker публикует панель. За serve ДОЛЖНО быть 127.0.0.1
# (loopback). Прямой Tailscale-IP (100.64.0.0/10) допустим ТОЛЬКО как временный
# режим до перевода за serve. 0.0.0.0 деплой отклоняет (панель ушла бы в интернет).
PANEL_BIND=127.0.0.1
# Резолвер владельца сопоставляет tailnet-логин из заголовка с этим значением
# (email владельца в tailnet, напр. owner@example.com). Пусто → резолвер никого
# не признаёт владельцем; при включённом enforcement это заперло бы панель,
# поэтому задавать ДО флипа флагов ниже (R-P5-6).
OWNER_TAILSCALE_LOGIN=
# Ужесточение owner-identity. У Core и CC этот флаг работает ПО-РАЗНОМУ — это
# не один рычаг, а два слоя защиты личного контура:
#
#  • Core (АВТОРИТЕТНЫЙ слой). Гейтит данные: GET домена personal отдаёт 403
#    вместо содержимого, а owner-only мутации (approvals/роли/автономия) уходят
#    под второй пояс вместо общего SERVICE_TOKEN. ШТАТНЫЙ включатель — ТУМБЛЕР
#    панели «Система» → «Доступ: ужесточение owner-identity» (хранится в базе).
#    ЭТА переменная для Core — только АВАРИЙНЫЙ kill-switch:
#      пусто (по умолчанию) → решает база/дефолт = ВЫКЛ (мерж среза поведение
#                             прода не меняет), владелец включает из панели;
#      0                    → ЖЁСТКО выкл ВСЕГДА, даже если тумблер в базе = 1
#                             (аварийный выход, R-P5-6).
#    НЕ ставьте сюда 0 «на всякий случай» — это заблокирует тумблер панели.
#
#  • CC (route-level, defense-in-depth). Гейтит сам роут /domain/personal
#    (notFound/redirect не-владельцу). CC тумблер панели НЕ читает — он смотрит
#    ТОЛЬКО эту env и ТОЛЬКО значение "1". Пусто/иное → route-гейт CC ВЫКЛ (роут
#    рендерится, но его personal-данные всё равно приходят из Core 403 — утечки
#    нет). Чтобы поднять и честный отказ CC-слоя, поставьте здесь "1"
#    ДОПОЛНИТЕЛЬНО к тумблеру панели. "1" не форсит Core (тот слушает базу) и не
#    является kill-switch; kill-switch — только "0".
#
# Прочие домены (vendhub/globerent/mydon) не трогаются.
OWNER_IDENTITY_ENFORCED=
# Зарезервировано под будущее РАЗДЕЛЬНОЕ ужесточение чтения. Текущая сборка
# гейтит чтение personal тем же OWNER_IDENTITY_ENFORCED выше; кодом эта
# переменная пока не читается. Оставить пустой.
OWNER_READS_ENFORCED=

# Health становится degraded, если на файловом слое меньше этого остатка.
# Путь / внутри контейнера лежит на диске Docker-хоста; 0 отключает порог.
HEALTH_STORAGE_PATH=/
HEALTH_MIN_STORAGE_MB=1024

# Небезопасный аварийный вход сотрудников по освобождаемому @username.
# Штатный путь — одноразовое приглашение; включать только временно.
STAFF_LINK_BY_USERNAME=0

# ── Коннекторы ──
# VendHub / VHM24 (отдельный движок, подключается по API)
VHM24_API_URL=
VHM24_API_KEY=
# VendHub панель/офис (снятие отчётов источника). Пусто → коннектор выключен.
VH_PANEL_BASE=
VH_PANEL_TOKEN=
VH_PANEL_COOKIE=
VH_PANEL_LANG=ru
VH_OFFICE_BASE=
VH_OFFICE_SESSION=
VH_TIMEOUT=30000
# Платёжные системы — пока не подключены (см. отчёт Ф5)
MULTIKASSA_API_URL=
PAYME_API_KEY=
CLICK_API_KEY=
UZUM_API_KEY=
# Телефония
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# Didox (ЭДО РУз) — договоры и счета GLOBERENT полями API вместо выгрузки.
# Пусто → сбор выключен, работает прежний путь через сид.
# ВНИМАНИЕ: партнёрский токен НЕ выдаётся в личном кабинете. Его даёт
# аккаунт-менеджер Didox: t.me/Didox_account, +998 50 122 05 18.
DIDOX_BASE_URL=https://api-partners.didox.uz
DIDOX_PARTNER_TOKEN=
# ИНН компании и пароль пользователя Didox (вход без ЭЦП).
# Перебор пароля блокируется: 3 попытки в минуту → 10 минут, 10 → сутки.
DIDOX_TAX_ID=
DIDOX_PASSWORD=
# Необязательно: готовый токен пользователя, если вход сделан снаружи (живёт 6 часов).
DIDOX_USER_TOKEN=
# Ourvend (кабинет вендинга os.ourvend.com) — только чтение. Пусто → сбор выключен.
# Секреты СМЕНИТЬ перед запуском (Фаза 0 ТЗ) и держать только здесь, не в коде.
OURVEND_ACCOUNT=
OURVEND_PASSWORD=
OURVEND_GROUP_ID=729db8bd-02f5-49b9-bccb-53477e396a08
# Как часто собирать планограмму и продажи. "off" выключает сбор явно, пустая
# учётка выше — молча. Каждый сбор пишет slot_snapshot: это единственный
# материал для сверки заливки, поэтому реже 3 часов ставить не стоит. После
# слотов запускается детектор заливок.
OURVEND_SYNC_CRON=0 */3 * * *
# Сколько ждать ответа Core на ПРИЁМ вендинга (слоты, продажи, детектор
# заливок), мс. Обычные вызовы агентов по-прежнему ждут 10 секунд; приём — это
# одна транзакция на сотни строк, и на внешней базе по TLS он в 10 секунд не
# укладывался: с 24.08.2026 сбор падал каждые три часа «This operation was
# aborted» с machines_ok=0, хотя Core транзакцию дописывал. Пусто/мусор → 60000.
CORE_INGEST_TIMEOUT_MS=60000
# Учётный снапшот OurVend (П2 поглощения mydon-stock): суточные продажи по
# автоматам с догоном до 14 дней + утренний снимок остатков (Lot management).
# 08:05 — после съёма mydon-stock (07:50), чтобы паритет сверял одни сутки.
OURVEND_ACCOUNTING_CRON=5 8 * * *
# Источник учётного потока для Core: "stock" — чтение БД mydon-stock (как
# раньше), "own" — собственный снапшот. Переключать на own только после
# 7 зелёных дней GET /ourvend/parity (гейт П2 плана поглощения).
# П8b: это ФОЛБЭК под настройкой панели «Система» — переключатель теперь
# живёт в system_config (база важнее env), рунбук флипа — docs/CUTOVER.md.
# Без STOCK_DATABASE_URL значение здесь игнорируется — действует own.
OURVEND_ACCOUNTING_SOURCE=stock
# Пороги катовера (П8b) — панель «Система» (system_config), СЮДА НЕ
# ПРОБРОШЕНЫ: CUTOVER_GREEN_DAYS (7, порог серии зелёных дней паритета),
# STOCK_PARITY_TOLERANCE (3, ≥0, допуск сверки остатков — 15-минутный
# разрыв между съёмом зеркала 07:50 и агента 08:05), SNAPSHOT_STALE_HOURS
# (36, застой учётного снапшота), SNAPSHOT_RETENTION_DAYS (180, панель не
# примет ниже 180 — пол подняли с 90 в П8b: окно ретенции не имеет права быть
# уже самого широкого отчёта, DEAD_STOCK_DAYS_MAX = 180),
# STOCK_COUNT_RETENTION_DAYS (730, панель не примет ниже 730 — это потолок окна
# у листа «История склада», и ключ умеет только ПРОДЛИТЬ хранение).
# Дефолты — apps/core/src/system/config-spec.ts.
# Маршрут загрузки автоматов для плана закупа (П5a): серийники через запятую;
# правится и из панели настроек (база важнее env).
VENDING_ROUTE_ORDER=
# Полевой снек-контур (П4): порог усушки автомата, сум (по позиции за
# период) и порог детектора заливки по снимкам слотов, шт за окно 3 ч.
# Оба правятся из панели настроек (база важнее env).
SHRINK_ALERT_UZS=30000
REFILL_DETECT_MIN_UNITS=10
# Аналитика снек-контура (П5b): окна и пороги отчётов. Правятся из панели
# «Система», и база важнее env — при пустом значении в базе читается env,
# при пустом и там действует дефолт (тот же приоритет, что у двух ключей
# выше). Значения ниже — дефолты кода; раскомментируйте только если хотите
# сдвинуть окно ДО первой правки из панели: выставленная здесь переменная
# действует на ВСЕ отчёты и в панели видна как источник «env».
# DEAD_STOCK_DAYS=21
# PRICE_CHANGE_PCT=5
# PRICE_GAP_PCT=5
# COST_WINDOW_DAYS=90
# MARGIN_LOW_PCT=15
# Узлы автоматов VendHub (спека 2026-09-04-vendhub-parts-inventory). Всё
# правится из панели «Система» (база важнее env); здесь — дефолты кода.
# PARTS_TEMPLATE_COFFEE — состав кофейного автомата для автозаведения
# (JSON: вид узла × количество; по умолчанию 4 миксера, гриндер, варка,
# 8 бункеров, фильтр воды). PARTS_COUNT_PHOTO_REQUIRED — фото при
# инвентаризации узлов обязательно (пропуск только с причиной).
# PARTS_DRYING_STAGE — после мойки узел идёт на сушку, потом на склад.
# COFFEE_REFILL_CONSUMES — заливка бункера списывает ингредиент со склада
# по точным данным (пачки × вес или «после − до»).
# PARTS_TEMPLATE_COFFEE=[{"kind":"mixer","count":4},{"kind":"grinder","count":1},{"kind":"brewer","count":1},{"kind":"hopper","count":8},{"kind":"water_filter","count":1}]
# PARTS_COUNT_PHOTO_REQUIRED=1
# PARTS_DRYING_STAGE=1
# COFFEE_REFILL_CONSUMES=1
# Оффсайт-бэкапы mydon в Telegram (П1 поглощения): свой бот и чат. Пусто →
# фолбэк на аварийного бота сторожа из /etc/mydon-heartbeat.env (шумно).
TG_BACKUP_BOT_TOKEN=
TG_BACKUP_CHAT_ID=
# Кого проверяет /opt/backups/healthz_guard.sh, в виде host:port. Пусто →
# адрес берётся из WEB_PORT в .env наблюдаемой панели склада (так работает
# сегодня). Заполните, чтобы сторож перестал заглядывать в каталог склада
# вовсе — это последняя оставшаяся у него зависимость (П8.2 поглощения).
# Пусто И там, и там — сторож не проверяет наугад, а падает с записью в
# /opt/backups/backup.log: молчаливая проверка чужого адреса = ложные тревоги.
HEALTHZ_TARGET=
# Мониторинг кофе-бункеров (недолив/расхождение расхода) — внешней учётки не требует.
# По умолчанию раз в сутки в 07:00 (Asia/Tashkent). "off" выключает.
COFFEE_MONITOR_CRON=0 7 * * *
# Монитор графиков обслуживания: ставит задачи на работы, подходящие к сроку.
# 06:00 — ДО дайджеста сотрудникам (07:00) и брифинга владельца (07:30):
# к моменту рассылки задачи уже должны стоять. "off" выключает.
MAINTENANCE_MONITOR_CRON=0 6 * * *
# Перец для хешей приглашений сотрудников. Случайная строка от 16 символов:
# в БД лежит только хеш кода, и без перца он подбирается по радужной таблице.
# Смена перца делает все ВЫДАННЫЕ приглашения недействительными.
INVITE_PEPPER=
# Аварийная привязка сотрудника по @username — переменная STAFF_LINK_BY_USERNAME
# задана выше, ЗДЕСЬ НЕ ПОВТОРЯЕМ (дубль в одном .env даёт "последняя строка
# побеждает" и однажды включил её незаметно). Ник в Telegram освобождается
# после смены, и занявший его получит чужую карточку — поэтому штатный путь
# это одноразовое приглашение.
# Имя бота без @ — нужно панели, чтобы собрать ссылку-приглашение.
# Сам бот спрашивает его у Telegram при старте и это значение не читает.
TELEGRAM_BOT_USERNAME=
# История заливок кофе-бункеров: группа, указанная владельцем (t.me/c/3307473916,
# для Bot API — чат -1003307473916). Историю ДО подключения бота Bot API не отдаёт —
# импорт идёт через экспорт Telegram Desktop (JSON) + tools/import-telegram-coffee.mjs.
TELEGRAM_COFFEE_HISTORY_CHAT=-1003307473916
# Подсказка модели про формат сообщений в этой группе (если распознаётся мало).
TELEGRAM_COFFEE_HINT=
# Курс валют — открытый API, ключ не нужен
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/
# Автокурс ЦБ РУз (USD/CNY/EUR/RUB → fx_rate): раз в сутки в 09:05 (Asia/Tashkent).
# Ручной курс, заданный сегодня, автообновление не перекрывает. "off" выключает.
FX_REFRESH_CRON=5 9 * * *
# Монитор инвариантов конвейера GLOBERENT (ИМ-40 без ГТД, оплаченный договор
# без закрытия) — раз в сутки в 07:10 к утреннему брифингу. "off" выключает.
GLOBERENT_MONITOR_CRON=10 7 * * *
# Notion — куда агент публикует отчёт о находке (task-worker). Пусто → не публикует,
# отчёт всё равно остаётся в MYDON. Нужны оба: токен интеграции и id родительской страницы.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# ── Агенты ──
# Порог автономии: T0 = агенты только предлагают (ответ владельца Ф6)
AGENT_AUTONOMY_MAX=T0
# Независимые fail-closed паузы: первая — только cron из паспортов,
# вторая — только задачи, назначенные агенту через Core.
AGENTS_SCHEDULES_PAUSED=1
AGENTS_TASKS_PAUSED=1
# Дневной потолок действий на агента и период опроса задач (мс)
AGENT_DAILY_ACTION_CAP=50
AGENT_TASK_INTERVAL_MS=60000
# llm-навыки (executor: llm, см. docs/AGENTS_ACTIVATION.md сценарий 1г): потолок
# символов одной KB-страницы в контексте модели (R-LS-8). Длиннее — обрезается с
# пометкой в facts.kbPages. Минимум 500; пусто → 12000.
LLM_SKILL_KB_PAGE_CHARS=
# Денежный бюджет ($) контролирует единый Core-ledger. Только проверенный
# Claude Agent SDK с явно выключенными usage credits и явно локальные
# модели проходят мимо USD-ledger; HTTP по умолчанию metered.
AGENT_DAILY_BUDGET_USD=5
# Единый потолок Bot, CC, Documents, Agents и embeddings. В панели
# system_config важнее env. Оставляем пустым: Core применит fallback $10/сутки,
# а при rollout сохранит явно заданный legacy AGENT_GLOBAL_BUDGET_USD.
LLM_GLOBAL_DAILY_BUDGET_USD=
# Потолок одного физического provider-вызова/reservation.
LLM_MAX_RESERVATION_USD=3
# Legacy: оставлять пустым на новой установке; существующее явное значение
# сохраняется до первого атомарного сохранения нового LLM-профиля.
AGENT_GLOBAL_BUDGET_USD=
# LLM-путь агентов (всё выключено по умолчанию):
#  • CLI-подписка агентов отключена fail-closed: `claude auth status`
#    не отдаёт машиночитаемый флаг usage credits/overage. `LLM_PROVIDER=claude-cli`
#    поэтому блокирует запуск; Codex/Gemini CLI тоже заблокированы.
#  • рабочий production-маршрут: официальный OpenAI API без промежуточного
#    gateway; exact endpoint и pricing provider проверяются fail-closed.
# LLM_ENABLED=0 — отдельный fail-closed тумблер. Выбор модели/цены ещё
# не разрешает расходы. Рабочий production route по умолчанию — openai-api
# + серверный ключ. Codex subscription остаётся видна в панели, но заблокирована:
# CLI не доказывает, расходует следующий turn включённый лимит или ChatGPT credits.
LLM_ENABLED=0
LLM_ROUTE=openai-api
LLM_PROVIDER=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Не URL/секрет: exact provider route. Каталог должен содержать активную цену
# каждого используемого SKU. Для openai-api значение обязано быть openai.
LLM_PRICE_PROVIDER_ID=openai
# HTTP по умолчанию метрируется в Core-ledger. Этот bypass намеренно env-only,
# в панели его нет. local ставьте ТОЛЬКО для явно бесплатной локальной модели;
# отсутствие цены не делает API бесплатным.
LLM_HTTP_BILLING_MODE=metered
LLM_MODEL=gpt-5.6-sol
LLM_FALLBACK_MODELS=
# Семантическая память (RAG, #6b): OpenAI-совместимый /embeddings. Пусто →
# память спит (остаётся дельта-память по сигнатуре). Держать в Tailscale.
EMBED_BASE_URL=
EMBED_API_KEY=
# Exact provider route для embeddings; в каталоге нужны все routed SKU.
# Обязателен при EMBED_BILLING_MODE=metered; local может оставить пустым.
EMBED_PRICE_PROVIDER_ID=
# Как и chat HTTP: режим намеренно env-only; local допустим только как явное
# заявление о локальном бесплатном runtime.
EMBED_BILLING_MODE=metered
EMBED_MODEL=          # напр. text-embedding-3-small (иначе дефолт)
# OAuth подписки для Assistant SDK (Bot/CC). Перед каждым prompt SDK
# допускает вызов только если `extra_usage.is_enabled === false`;
# любой true/null/неизвестный ответ fail-closed. Agents CLI этот токен не запускает.
CLAUDE_CODE_OAUTH_TOKEN=
# Рабочая директория Cowork-исполнения
COWORK_BASE_DIR=

# ── Помощник (панель) ──
# Модель ассистента панели
MYDON_ASSISTANT_MODEL=

# ── Карта (панель) ──
# Источник тайлов картографической подложки (карта автоматов на дашборде и
# выбор точки в карточках). Шаблон Leaflet с {z}/{x}/{y}, например
#   https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}.png?api_key=…
# ПУСТО (дефолт) → бесключевые тайлы OpenStreetMap
# (https://tile.openstreetmap.org/{z}/{x}/{y}.png) с обязательной атрибуцией
# «© OpenStreetMap contributors». Дефолт выбран после того, как CARTO закрыл
# анонимный доступ и рисовал «API KEY REQUIRED» вместо города; трафик панели
# минимальный и в политику OSM укладывается. Значение с опечаткой (без
# {z}/{x}/{y} или не http/https) откатывается на OSM с предупреждением в
# серверных логах панели. Переменную читает СЕРВЕР панели (не NEXT_PUBLIC:
# та вшивается на сборке и в Docker-образ бы не попала) — компоненты карты
# получают её пропом. На проде и standby env-блоки mydon-cc в
# deploy/docker-compose*.yml — явные белые списки: переменная там проброшена
# строкой `MAP_TILES_URL: ${MAP_TILES_URL:-}`; убрать её — значение из
# серверного .env перестанет попадать в контейнер, и карта молча станет OSM.
MAP_TILES_URL=

# ── История (локальная модель/индекс) ──
HISTORY_DB_PATH=
HISTORY_MODEL_DIR=

# ── Бот ──
CORE_API_URL=http://127.0.0.1:3001
NOTIFY_INTERVAL_MS=60000
# Периоды напоминаний (мс): просроченные задачи и переделки
REMIND_INTERVAL_MS=3600000
REDO_NOTIFY_INTERVAL_MS=3600000

# ── Внешний сторож (запускается на ДРУГОМ провайдере, отдельным ботом) ──
WATCHDOG_TARGET_URL=
WATCHDOG_BOT_TOKEN=
WATCHDOG_CHAT_IDS=
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_FAILURES=3

# ── Локальная rollback/recovery БД (docker compose) ──
POSTGRES_USER=mydon
POSTGRES_PASSWORD=
POSTGRES_DB=mydon

# Пароль шифрования offsite-копии секретов (.env-архив уходит в Telegram).
#
# Без него архив секретов НЕ отправляется наружу вовсе — открытым текстом
# класть пароль базы и токены ботов в чужое хранилище нельзя.
#
# ⚠️ Храните пароль ВНЕ сервера (менеджер паролей). Он есть и здесь, но
# offsite защищает от ПОТЕРИ машины: если пароль остался только на ней,
# восстановить зашифрованный архив будет нечем.
#
# Расшифровать: openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 \
#   -in env-files_ДАТА.tar.gz.enc -out env-files.tar.gz
BACKUP_ENC_PASSPHRASE=

# Второй независимый offsite: private Backblaze B2 bucket.
# Если все три значения пусты, канал ещё не активирован. Частичная конфигурация
# считается ошибкой backup. Все три архива шифруются и аутентифицируются через
# rclone crypt. Production key ограничьте одним bucket и префиксом: нужны
# listAllBucketNames, listBuckets, listFiles, readFiles, writeFiles и
# readBucketEncryption, но не deleteFiles. Отдельный read-only recovery key и
# BACKUP_ENC_PASSPHRASE храните вне production.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_PREFIX=mydon/daily
