{
  "name": "mydon",
  "version": "0.0.0",
  "private": true,
  "description": "MYDON — единый контур управления направлениями (GLOBERENT, VendHub, личное)",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "telegram": "^2.26.22",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "adm-zip": ">=0.6.0",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=3.1.5",
      "js-yaml": ">=4.3.1"
    }
  }
}
